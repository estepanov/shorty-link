{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Self-hosters should change this to their own Worker name.
	"name": "shorty-link",
	"main": "src/server.ts",
	"compatibility_date": "2026-04-16",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true,
	"vars": {
		// Self-hosters should replace these with their production hostnames and origin.
		"BETTER_AUTH_ALLOWED_HOSTS": "localhost:3000,localhost:8787,*.workers.dev",
		"BETTER_AUTH_FALLBACK_URL": "http://localhost:3000",
		"PASSKEY_RP_NAME": "Shorty Link"
	},
	"routes": [
		// Self-hosters should change this to their own domain.
		// Note: you can have multiple routes if you want to support multiple domains, but make sure to update the allowed hosts.
		{
			// Self-hosters should change this to their own domain.
			"pattern": "some-cool-fake-website-that-doesnt-exist-yet.link",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			// Self-hosters may rename the D1 database, but must keep the DB binding name.
			"database_name": "shorty-link",
			"database_id": "replace-with-your-d1-database-id",
			"migrations_dir": "./migrations"
		}
	],
	"ai": {
		"binding": "AI"
	}
	// Optional analytics queue. Create the queues first, then uncomment:
	// pnpm exec wrangler queues create shorty-link-analytics
	// pnpm exec wrangler queues create shorty-link-analytics-dlq
	// "queues": {
	//   "producers": [
	//     { "binding": "ANALYTICS_QUEUE", "queue": "shorty-link-analytics" }
	//   ],
	//   "consumers": [
	//     {
	//       "queue": "shorty-link-analytics",
	//       "max_batch_size": 100,
	//       "max_batch_timeout": 5,
	//       "max_retries": 5,
	//       "dead_letter_queue": "shorty-link-analytics-dlq"
	//     }
	//   ]
	// }
	// Optional daily-rollup cron. Uncomment to fold raw events into
	// redirect_event_daily / redirect_event_dimension_daily:
	// "triggers": {
	//   "crons": ["*/5 * * * *"]
	// }
	// Optional Analytics Engine dataset. Writes are extra emit, not the admin
	// source of truth. Create the dataset in the dashboard, then uncomment:
	// "analytics_engine_datasets": [
	//   { "binding": "ANALYTICS", "dataset": "shorty_link_clicks" }
	// }
}
